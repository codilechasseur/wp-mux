{
    "name": "codilechasseur/wp-mux",
    "description": "Provides a media library integration for the MUX video hosting platform.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.1.1",
    "authors": [
        {
            "name": "Codi Lechasseur",
            "homepage": "https://wpmux.com"
        }
    ],
    "homepage": "https://wpmux.com",
    "support": {
        "source": "https://github.com/codilechasseur/wp-mux"
    },
    "require": {
        "php": ">=8.0",
        "composer/installers": "^2.0",
        "freemius/wordpress-sdk": "^2.10"
    },
    "extra": {
        "installer-path": "wp-content/plugins/wp-mux"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
